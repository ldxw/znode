# syntax=docker/dockerfile:1

# ---------- Stage 1: 只装「运行期」依赖 ----------
# 装完顺手把「只服务于 Prisma CLI」的部分删掉：prisma 本身、它的引擎目录、
# effect + @prisma/config（CLI 的配置加载器）、typescript。
# 理由：运行时真正用的查询引擎在生成出来的 .prisma/client/ 里自带一份
# （已实测：删掉这些之后 PrismaClient 仍能加载引擎，只是连不上数据库）。
# 这一步约省 121M。确实需要 prisma db push 的场景用下面的 migrator 阶段。
FROM node:22-bookworm-slim AS prod-deps
WORKDIR /app

COPY backend/package.json backend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --omit=dev --no-audit --no-fund \
    && rm -rf node_modules/prisma \
              node_modules/@prisma/engines \
              node_modules/@prisma/config \
              node_modules/effect \
              node_modules/typescript

# ---------- Stage 2: 构建后端 ----------
# node:22（20 已在 2026-04 EOL）；bookworm（bullseye 已 EOL，apt 源失效会让构建随机失败）
FROM node:22-bookworm AS builder
WORKDIR /app

# 先装依赖（缓存友好：改源码不会重装）
COPY backend/package.json backend/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund

# 再拷源码
COPY backend ./

# Prisma 客户端生成 + 打包（tsup）
RUN npx prisma generate \
    && node scripts/build.mjs

# ---------- Stage 3: 迁移镜像（独立 target，只有 prisma CLI + schema）----------
# 用法：docker compose --profile migrate run --rm migrate
# 只在表结构有变化时跑一次，不参与日常启动。
# 注意：这一段特意放在运行时阶段【之前】—— Docker 的默认构建目标是最后一个 stage，
# 默认 target 必须是运行时镜像，否则 `docker build` 不带 --target 会构建出迁移镜像。
FROM node:22-bookworm-slim AS migrator
WORKDIR /app

# 版本和 backend/package.json 里 prisma 的声明保持一致
ARG PRISMA_VERSION=^6.19.3

RUN --mount=type=cache,target=/root/.npm \
    npm install --no-save --no-audit --no-fund "prisma@${PRISMA_VERSION}"

COPY backend/prisma ./prisma

ENV NODE_ENV=production

ENTRYPOINT ["/app/node_modules/.bin/prisma", "db", "push", "--skip-generate"]

# ---------- Stage 4: 运行时（slim，不带编译工具链）----------
# 放在最后 = 默认 target；这里显式起名 runtime，CI 也可以写 --target runtime。
FROM node:22-bookworm-slim AS runtime
WORKDIR /app

# 生产模式：Express / 各库都会按这个走生产分支
ENV NODE_ENV=production
ENV PORT=3002

# 运行期依赖：只带生产依赖，并已在 prod-deps 里剪掉 Prisma CLI 相关部分
COPY --from=prod-deps /app/node_modules ./node_modules

# 应用产物 + Prisma schema
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/prisma ./prisma

# 生成好的 Prisma 客户端（含它自带的那份查询引擎）在 builder 里，覆盖上去
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /app/node_modules/@prisma/client ./node_modules/@prisma/client

# 上传目录：默认值算出来是 /public/uploads（容器根目录，非 root 用户写不进去），
# 这里显式指到 /app 下并一起交给 node 用户；要持久化就在 compose 里给这个路径挂卷。
ENV UPLOADS_DIR=/app/public/uploads
# 只把上传目录交给 node 用户：node_modules / dist 运行时是只读的，没必要递归 chown。
# （实测：递归 chown 整个 /app 要 70 秒，只 chown 上传目录不到 1 秒）
RUN mkdir -p /app/public/uploads \
    && chown node:node /app/public/uploads

# 不用 root 跑应用
USER node

EXPOSE 3002

# 用 node 自己发探针，省掉 curl / wget（少两个 apt 包）
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||3002)+'/health',r=>process.exit(r.statusCode===200?0:1)).on('error',()=>process.exit(1))"

# 启动服务。表结构同步不放在这里了 —— 运行时镜像已经没有 Prisma CLI，
# 改用 migrator 镜像 / compose 里的 migrate 服务。
CMD ["node", "/app/dist/index.js"]
