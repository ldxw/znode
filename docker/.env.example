# docker-compose.yaml 用的变量。复制成 docker/.env 再改：
#   cp docker/.env.example docker/.env
#
# 注意：这个文件同时也是 backend 服务的 env_file，所以后端的其它配置
#      （数据库连接串、各个 OAuth key 等）也写在这里。
#      ⚠️ 本文件里除了下面那行真正启用的连接串，不要再出现任何形如 "DATABASE_URL=" 的
#      注释或说明示例：应用是用正则从本文件里读它的，注释行会被当成真值，
#      表现为启动正常但登录/状态检查报「数据库凭据无效」。

# ── MySQL ─────────────────────────────────────────────────────────────
# 必填（不设的话 compose 会直接报错）：别再用仓库里那串示例密码
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=znode
MYSQL_USER=znode
MYSQL_PASSWORD=

# ── 时区 ──────────────────────────────────────────────────────────────
# 容器时区：备份定时任务（node-cron）按它计算，不设就是 UTC。
# 想在每天凌晨 3 点（北京时间）备份，这里填 Asia/Shanghai，定时表达式就按北京时间写。
TZ=Asia/Shanghai

# ── 后端 ──────────────────────────────────────────────────────────────
# 允许跨域的前端域名，多个用英文逗号分隔，例如：
#   FRONTEND_URL=https://a.example.com,https://b.example.com
# 前后端同域（都由本 compose 的 nginx 提供）时留空即可
FRONTEND_URL=

# 数据库连接串（后端用）—— 必填！密码要和上面的 MYSQL_PASSWORD 完全一致。
# 实测：这行漏了不填，后端会连不上库直接退出，容器一直不健康。
DATABASE_URL=mysql://znode:改成你的MYSQL_PASSWORD@mysql:3306/znode

# 其它后端配置参考 backend/.env.example（OAuth、邮件、备份等）

# ── 前端 ──────────────────────────────────────────────────────────────
# 浏览器访问后端的地址，例如 https://api.example.com
# 留空 = 同域反代：前端请求走当前域名，由 nginx 把 /api 转给 backend:3002
API_URL=
