# syntax=docker/dockerfile:1

# ---------- Stage 1: 构建前端 ----------
# node:22（20 已在 2026-04 EOL）；bookworm（bullseye 已 EOL，apt 源失效会让构建随机失败）
FROM node:22-bookworm AS builder
WORKDIR /app

# 先只装依赖：改源码不会让这一层失效；npm 缓存用 cache mount，重复构建更快
COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund

# 再拷源码（忽略规则在仓库根的 .dockerignore，node_modules/.git 等不会进来）
COPY . .

# API 地址构建期只写占位符 __API_URL__，运行时由 entrypoint-frontend.sh 替换成真实地址，
# 所以同一个镜像可以部署到任意域名，不用重新构建。
ARG VITE_API_URL=__API_URL__
ENV VITE_API_URL=${VITE_API_URL}

RUN --mount=type=cache,target=/app/node_modules/.cache \
    NODE_OPTIONS="--max-old-space-size=1536" npx vite build

# ---------- Stage 2: Nginx 运行时 ----------
FROM nginx:1.27-alpine

# 构建好的静态文件
COPY --from=builder /app/dist /usr/share/nginx/html

# 前后端同域反代（默认）；另一份供前后端分开部署时用
COPY docker/nginx-frontend-api.conf /etc/nginx/conf.d/default.conf
COPY docker/nginx-frontend-backend.conf /etc/nginx/conf.d/frontend-backend.conf

COPY docker/entrypoint-frontend.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 80 81 82

# nginx:alpine 自带 busybox 的 wget，直接用它做存活探针（不再为了 bash 装包）
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1

ENTRYPOINT ["/entrypoint.sh"]
